{
    "name": "jil-highlite",
    "displayName": "Autosys JIL Highlite",
    "description": "AutoSys JIL syntax highlighting, IntelliSense, hover docs, linter, snippets, document outline, and interactive visual job flow graph.",
    "icon": "images/jil-highlighter-icon.png",
    "publisher": "czdrager",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/dejfikus/autosys-jil"
    },
    "version": "0.2.0",
    "engines": {
        "vscode": "^1.45.0"
    },
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:jil",
        "onCommand:jil.showJobGraph"
    ],
    "categories": [
        "Programming Languages",
        "Linters",
        "Snippets",
        "Visualization"
    ],
    "keywords": [
        "autosys",
        "jil",
        "workload automation",
        "scheduler",
        "broadcom",
        "ca workload automation"
    ],
    "contributes": {
        "languages": [
            {
                "id": "jil",
                "aliases": [
                    "AutoSys JIL",
                    "jil"
                ],
                "extensions": [
                    ".jil"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "jil",
                "scopeName": "scope.jil",
                "path": "./syntaxes/jil.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "jil",
                "path": "./snippets/jil.snippets.json"
            }
        ],
        "commands": [
            {
                "command": "jil.showJobGraph",
                "title": "AutoSys JIL: Open Visual Job Flow Graph",
                "category": "AutoSys JIL",
                "icon": "$(type-hierarchy-sub)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "jil.showJobGraph",
                    "when": "editorLangId == jil",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "command": "jil.showJobGraph",
                    "when": "editorLangId == jil",
                    "group": "navigation"
                }
            ]
        }
    },
    "devDependencies": {
        "js-yaml": "^3.14.0"
    }
}
